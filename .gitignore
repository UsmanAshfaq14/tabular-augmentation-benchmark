# ---------------------------------------------------------------
# Experiment outputs: keep the small result tables, drop the bulk
# (synthetic data, train/test splits, SHAP arrays, per-seed plots)
# ---------------------------------------------------------------
Implementation/outputs/**
!Implementation/outputs/**/
!Implementation/outputs/**/metrics_rf_seed*.csv
!Implementation/outputs/**/metrics_xgb_seed*.csv
!Implementation/outputs/**/shap_stability_rf_seed*.csv
!Implementation/outputs/**/shap_stability_xgb_seed*.csv
!Implementation/outputs/**/shap_importance_rf_seed*.csv
!Implementation/outputs/**/shap_importance_xgb_seed*.csv
!Implementation/outputs/**/distribution_metrics_seed*.csv
!Implementation/outputs/**/residual_report_*_seed*.txt
!Implementation/outputs/**/classification_report_*_seed*.txt
!Implementation/outputs/**/comparison/all_methods_*.csv
!Implementation/outputs/**/comparison/*.png
!Implementation/outputs/**/experiment_config.json
!Implementation/outputs/**/run.log
!Implementation/outputs/**/great_run.log

